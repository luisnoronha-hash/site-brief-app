# Database
DATABASE_URL="postgresql://user:password@localhost:5432/site_brief"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SUBSCRIPTION="" # price_xxx for the $99/mo plan

# S3-compatible object storage
S3_REGION="us-east-1"
S3_BUCKET="site-brief"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="" # optional, for non-AWS S3-compatible providers

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="Site Brief <no-reply@site-brief.com>"
ADMIN_EMAIL="admin@site-brief.com"
ADMIN_PASSWORD="" # optional; min 12 chars. Sets the seeded admin's initial password.
                  # If blank, deploys generate a random one and print it in the build log.

# Google Places Autocomplete (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
